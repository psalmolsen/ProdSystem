rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ───────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isApproved() {
      return signedIn();
    }

    function isAdmin() {
      return isApproved();
    }

    // ── COLLECTION RULES ───────────────────────────────────────────────────

    // USERS COLLECTION: users/{userId}
    match /users/{userId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        request.auth.uid == userId ||
        isApproved()
      );
      
      allow create, update, delete: if isApproved();
    }

    // ACCESS REQUESTS COLLECTION: accessRequests/{requestId}
    match /accessRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        request.auth.uid == requestId ||
        isApproved()
      );
      
      allow create: if signedIn() && (
        (request.resource.data.uid == request.auth.uid && request.resource.data.status == "pending") ||
        isApproved()
      );
      
      allow update, delete: if isApproved();
    }

    // JOB ORDERS COLLECTION: jobOrders/{jobOrderId}
    match /jobOrders/{jobOrderId} {
      allow read: if isApproved();
      allow create, update, delete: if isApproved();

      match /production/{dateStr} {
        allow read, create, update, delete: if isApproved();
      }
    }

    // BACKJOBS COLLECTION: backjobs/{backjobId}
    match /backjobs/{backjobId} {
      allow read, create, update, delete: if isApproved();
    }

  }
}
